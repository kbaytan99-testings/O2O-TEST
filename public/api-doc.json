{     "openapi": "3.0.0",     "info": {         "title": "Books API",         "description": "REST API for searching and querying books using Gutendex",         "version": "1.0.0"     },     "servers": [         {             "url": "http://localhost:8000",             "description": "Local development server"         },         {             "url": "http://localhost:8000",             "description": "Docker container"         }     ],     "paths": {         "/api/doc.json": {             "get": {                 "operationId": "get_api_doc_swagger_json",                 "responses": {                     "default": {                         "description": ""                     }                 }             }         },         "/api/books": {             "get": {                 "tags": [                     "Books"                 ],                 "summary": "Search books",                 "description": "Search books by a query string from the Gutendex API",                 "operationId": "get_api_books_search",                 "parameters": [                     {                         "name": "search",                         "in": "query",                         "description": "Search query string",                         "required": true,                         "schema": {                             "type": "string",                             "example": "shakespeare"                         }                     }                 ],                 "responses": {                     "200": {                         "description": "List of books matching the search query",                         "content": {                             "application/json": {                                 "schema": {                                     "type": "array",                                     "items": {                                         "properties": {                                             "id": {                                                 "type": "integer",                                                 "example": 1342                                             },                                             "title": {                                                 "type": "string",                                                 "example": "Pride and Prejudice"                                             },                                             "subjects": {                                                 "type": "array",                                                 "items": {                                                     "type": "string"                                                 }                                             },                                             "authors": {                                                 "type": "array",                                                 "items": {                                                     "properties": {                                                         "name": {                                                             "type": "string"                                                         },                                                         "birthYear": {                                                             "type": "integer",                                                             "nullable": true                                                         },                                                         "deathYear": {                                                             "type": "integer",                                                             "nullable": true                                                         }                                                     },                                                     "type": "object"                                                 }                                             }                                         },                                         "type": "object"                                     }                                 }                             }                         }                     },                     "400": {                         "description": "Bad request - search parameter is required",                         "content": {                             "application/json": {                                 "schema": {                                     "properties": {                                         "error": {                                             "type": "string",                                             "example": "Search parameter is required"                                         }                                     },                                     "type": "object"                                 }                             }                         }                     }                 }             }         },         "/api/books/{id}": {             "get": {                 "tags": [                     "Books"                 ],                 "summary": "Get book by ID",                 "description": "Get detailed information about a specific book by its Gutendex ID",                 "operationId": "get_api_books_show",                 "parameters": [                     {                         "name": "id",                         "in": "path",                         "description": "Book ID from Project Gutenberg",                         "required": true,                         "schema": {                             "type": "integer",                             "pattern": "\\d+",                             "example": 1342                         }                     }                 ],                 "responses": {                     "200": {                         "description": "Book details",                         "content": {                             "application/json": {                                 "schema": {                                     "properties": {                                         "id": {                                             "type": "integer",                                             "example": 1342                                         },                                         "title": {                                             "type": "string",                                             "example": "Pride and Prejudice"                                         },                                         "subjects": {                                             "type": "array",                                             "items": {                                                 "type": "string"                                             }                                         },                                         "authors": {                                             "type": "array",                                             "items": {                                                 "properties": {                                                     "name": {                                                         "type": "string",                                                         "example": "Austen, Jane"                                                     },                                                     "birthYear": {                                                         "type": "integer",                                                         "example": 1775,                                                         "nullable": true                                                     },                                                     "deathYear": {                                                         "type": "integer",                                                         "example": 1817,                                                         "nullable": true                                                     }                                                 },                                                 "type": "object"                                             }                                         }                                     },                                     "type": "object"                                 }                             }                         }                     },                     "404": {                         "description": "Book not found",                         "content": {                             "application/json": {                                 "schema": {                                     "properties": {                                         "error": {                                             "type": "string",                                             "example": "Book with ID 999999 not found"                                         }                                     },                                     "type": "object"                                 }                             }                         }                     }                 }             }         }     },     "tags": [         {             "name": "Books"         }     ] }